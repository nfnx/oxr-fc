    "/v1/parse/sync": {
      "post": {
        "summary": "Parse PDF/image and return Markdown and/or structured JSON",
        "operationId": "parse_v1_parse_sync_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "One PDF or single-frame document image; total body <=20 MiB, PDF <=20 pages."
                  },
                  "output_formats": {
                    "items": {
                      "type": "string",
                      "enum": [
                        "markdown",
                        "json"
                      ]
                    },
                    "type": "array",
                    "default": [
                      "markdown",
                      "json"
                    ]
                  },
                  "feature_config": {
                    "type": "string",
                    "description": "JSON string, e.g. {\"keep_header_footer\":true}."
                  },
                  "extra": {
                    "type": "string",
                    "description": "JSON string: temperature (0..2), top_p (0..1), repetition_penalty (>0)."
                  },
                  "element_formats": {
                    "type": "string",
                    "description": "JSON string; image=base64 (default) or none, formula=latex, table=html/markdown, cs=smiles/image."
                  },
                  "api_key": {
                    "type": "string",
                    "description": "Optional legacy field; not authentication. FC Bearer header is required."
                  }
                },
                "type": "object",
                "required": [
                  "file"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/SyncParseResponse"
                    },
                    {
                      "$ref": "#/components/schemas/BusinessError"
                    }
                  ],
                  "title": "Response Parse V1 Parse Sync Post"
                }
              }
            }
          }
        }
      }
    },
    "/v1/parse/async": {
      "post": {
        "summary": "Persist document and dispatch a durable FC asynchronous worker invocation",
        "operationId": "parse_v1_parse_async_post",
