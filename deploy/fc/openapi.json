                      "markdown",
                      "json"
                    ]
                  },
                  "feature_config": {
                    "type": "string",
                    "description": "JSON string, e.g. {\"keep_header_footer\":true}."
                  },
                  "extra": {
                    "type": "string",
                    "description": "JSON string: temperature (0..2), top_p (0..1), repetition_penalty (>0)."
                  },
                  "element_formats": {
                    "type": "string",
                    "description": "JSON string; image=base64 (default) or none, formula=latex, table=html/markdown, cs=smiles/image."
                  },
                  "api_key": {
                    "type": "string",
                    "description": "Optional legacy field; not authentication. FC Bearer header is required."
                  }
                },
                "type": "object",
                "required": [
                  "file"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AsyncSubmitResponse"
                    },
                    {
                      "$ref": "#/components/schemas/BusinessError"
