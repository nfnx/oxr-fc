    "/v1/demo/jobs": {
      "post": {
        "summary": "Submit a persistent Demo job with page previews and image resources",
        "operationId": "parse_v1_demo_jobs_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "temperature": {
                    "type": "number",
                    "maximum": 2.0,
                    "minimum": 0.0,
                    "default": 0
                  },
                  "top_p": {
                    "type": "number",
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "default": 1
                  },
                  "repetition_penalty": {
                    "type": "number",
                    "maximum": 2.0,
                    "minimum": 0.1,
                    "default": 1
                  },
                  "keep_header_footer": {
                    "type": "boolean",
                    "default": true
                  }
                },
                "type": "object",
                "required": [
                  "file"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
